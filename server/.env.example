NODE_ENV=development
PORT=3001

# Firebase Admin SDK (Project Settings → Service Accounts → Generate new private key)
FIREBASE_PROJECT_ID=photos-ace50
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Bunny.net Edge Storage (bunny.net → Storage → your zone → FTP & API Access).
# The Access Key is server-only, never sent to clients.
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_HOST=sg.storage.bunnycdn.com
BUNNY_ACCESS_KEY=

# Signs the short-lived tokens embedded in media content URLs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required in production; a random one is used automatically in development.
CONTENT_TOKEN_SECRET=

CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Per-upload cap and per-user total storage cap (bytes). Defaults: 200MB / 15GB.
MAX_FILE_SIZE_BYTES=209715200
DEFAULT_QUOTA_BYTES=16106127360

# Google AI Studio API key (aistudio.google.com/apikey). Powers photo search
# captioning/tagging and document detection on upload. Blank = AI features
# quietly skip themselves, everything else still works.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
